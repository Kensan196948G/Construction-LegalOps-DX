# =============================================================================
# Construction-LegalOps-DX  frontend  ―  local development environment template
# =============================================================================
# このファイルをコピーして `.env.local` を作成してください:
#   cp .env.local.example .env.local
#
# 本番値 (Entra ID クレデンシャル等) は Azure Key Vault / GitHub Secrets で管理し、
# このファイルには **絶対に実値を書き込まない** こと。
# =============================================================================

# ---- Backend API ----
# 専用ポート割当（docs/PORT_ALLOCATION.md 参照）。ブラウザ axios クライアントが
# 参照する URL で /api/v1 を含む。ビルド時にバンドルへ焼き込まれるため、
# ホスト公開ポート (backend=8010) を指すこと。
NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1
# サーバーサイド認証 (auth.config.ts / refresh-token.ts) が参照する API ベース URL。
# コード側で /api/v1/auth/* を付与するため /api/v1 は含めない。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010

# ---- next-auth ----
# `openssl rand -base64 32` で生成した値に置き換える
AUTH_SECRET=replace-me

# ---- Microsoft Entra ID (HENNGE One 経由 OIDC) ----
# Loop 4 で HENNGE One discovery URL から導出した実値に置き換える
AUTH_MICROSOFT_ENTRA_ID_ID=replace-me
AUTH_MICROSOFT_ENTRA_ID_SECRET=replace-me
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# HENNGE One OIDC discovery (Loop 4 で issuer / endpoint 解決に使用)
HENNGE_OIDC_DISCOVERY_URL=replace-me
