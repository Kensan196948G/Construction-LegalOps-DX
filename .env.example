# ============================================================
# Construction-LegalOps-DX 環境変数サンプル
# 利用方法: `cp .env.example .env` の上、値を埋めてください。
# 本ファイルはコミット対象、`.env` はコミット対象外（.gitignore 済み）。
# ============================================================

# ------------------------------------------------------------
# 実行環境
# ------------------------------------------------------------
# development | staging | production
APP_ENV=development
# debug | info | warning | error
LOG_LEVEL=info
# UTC 推奨。日本時間で扱う場合は Asia/Tokyo
TZ=Asia/Tokyo

# ------------------------------------------------------------
# サービスポート
# ------------------------------------------------------------
# 専用ポート割当（マルチプロジェクト共存ホストでの衝突回避）。
# 詳細は docs/PORT_ALLOCATION.md を参照。ホスト公開ポートのみ専用化し、
# コンテナ内部ポート (8000/3000/80/443/5432/6379) は不変。
BACKEND_PORT=8010
FRONTEND_PORT=3010
NGINX_PORT=8410
NGINX_TLS_PORT=8453

# ------------------------------------------------------------
# データベース (PostgreSQL 16)
# ------------------------------------------------------------
# 例: postgresql+asyncpg://user:password@host:5432/dbname
DB_URL=postgresql+asyncpg://legalops:legalops_dev@postgres:5432/legalops
POSTGRES_USER=legalops
POSTGRES_PASSWORD=legalops_dev
POSTGRES_DB=legalops
POSTGRES_HOST=postgres
# ホスト公開ポート（専用割当）。コンテナ内部は 5432 のまま。
POSTGRES_PORT=5442

# ------------------------------------------------------------
# Redis (キャッシュ・ジョブキュー)
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# ホスト公開ポート（専用割当）。コンテナ内部は 6379 のまま。
REDIS_PORT=6392
# 本番では必ず強力なパスワードを設定 (docker-compose.prod.yml は :? でハードフェイル)
REDIS_PASSWORD=

# ------------------------------------------------------------
# Celery (非同期ジョブ)
# DB 1: broker, DB 2: result backend
# 本番では `redis://:${REDIS_PASSWORD}@redis:6379/1` 形式
# ------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------
# 認証 / JWT
# ------------------------------------------------------------
# 必ず本番環境では十分なエントロピーを持つランダム値に置き換える
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ------------------------------------------------------------
# Microsoft Entra ID (OIDC / SSO)
# ------------------------------------------------------------
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-entra-app-secret
ENTRA_REDIRECT_URI=http://localhost:3010/auth/callback
# 例: openid profile email offline_access User.Read Sites.Read.All
ENTRA_SCOPES=openid profile email offline_access User.Read

# ------------------------------------------------------------
# Anthropic Claude API (Agent ②契約読解・要約 / ③論点整理・文案)
# ------------------------------------------------------------
# 注意: 本番 Claude API キーは 2026-07-01 まで利用不可。
# それまではキー未設定でもシステムは劣化動作（graceful degradation）し、
# Claude 系 Agent は休眠、Perplexity リサーチ Agent のみ稼働する。
# 管理画面「AI設定」からも保存できるが、平文では DB に保存されない（暗号化必須）。
CLAUDE_API_KEY=sk-ant-replace-me
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_MAX_TOKENS=4096
# AI 出力には必ず人間レビューが必要（README の免責参照）
CLAUDE_TIMEOUT_SECONDS=60

# ------------------------------------------------------------
# Perplexity Sonar API (Agent ①: 契約リサーチ / Web グラウンディング)
# ------------------------------------------------------------
# 機密の契約本文は送信しない。抽象化した論点・キーワードのみを送り、
# 引用は公的ソース allowlist（e-Gov 法令検索 / 国交省 / 裁判所）に限定して
# 監査可能な出典トレイルを残す。Sonar は既定で Zero Data Retention。
# 未設定でも起動可（その場合「設定テスト」は失敗を返す）。
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_TIMEOUT_SECONDS=45

# ------------------------------------------------------------
# 設定値の保存時暗号化 (AI プロバイダ API キーの at-rest 暗号化)
# ------------------------------------------------------------
# プロバイダ API キーを DB に保存する前に Fernet で暗号化するための鍵。
# 推奨: `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# 任意のパスフレーズでも可（内部で SHA-256 → 32byte 鍵に導出）。
# 未設定時は JWT_SECRET から決定的に導出し、平文保存には決して落ちない（fail-closed）。
SETTINGS_ENCRYPTION_KEY=

# ------------------------------------------------------------
# SharePoint Online (契約書ストレージ連携)
# ------------------------------------------------------------
SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/legal
SHAREPOINT_DRIVE_ID=
SHAREPOINT_LIBRARY_NAME=Contracts
# next.config.mjs の images.remotePatterns に登録するホスト (カンマ区切り)
# 例: contoso.sharepoint.com,contosostorage.blob.core.windows.net
SHAREPOINT_HOST=contoso.sharepoint.com
AZURE_BLOB_HOST=contosostorage.blob.core.windows.net

# ------------------------------------------------------------
# HENNGE One (メール DLP / SSO ゲートウェイ)
# 日本国内利用シェアの高い HENNGE 経由で SaaS アクセスを集約する場合に設定
# ------------------------------------------------------------
HENNGE_TENANT_ID=replace-with-hennge-tenant-id
HENNGE_API_KEY=replace-with-hennge-api-key
HENNGE_API_BASE_URL=https://api.hennge.com

# ------------------------------------------------------------
# desknet's NEO (社内ワークフロー連携)
# ------------------------------------------------------------
DESKNET_API_URL=https://desknet.example.co.jp/api/v1
DESKNET_API_TOKEN=replace-with-desknet-token

# ------------------------------------------------------------
# CORS / フロント連携
# ------------------------------------------------------------
# カンマ区切りで複数指定可
CORS_ORIGINS=http://localhost:3010,http://localhost
# サーバーサイド認証 (auth.config.ts / refresh-token.ts) が参照する API ベース URL。
# コード側で /api/v1/auth/* を付与するため、ここには /api/v1 を含めない。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
# ブラウザ axios クライアント (lib/api/client.ts) が参照する API URL。
# こちらは /api/v1 を含める。ビルド時にバンドルへ焼き込まれるためホスト公開ポートを指す。
NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1

# ------------------------------------------------------------
# 監査ログ / 電子帳簿保存法対応
# ------------------------------------------------------------
# 法定保存期間（年）。建設業法・電帳法に従って設定。
AUDIT_RETENTION_YEARS=10
# 監査ログ用バケット / 出力先（実装は Loop 2 以降）
AUDIT_LOG_SINK=stdout

# ------------------------------------------------------------
# 機能フラグ
# ------------------------------------------------------------
FEATURE_AI_REVIEW=true
FEATURE_SHAREPOINT_SYNC=false
FEATURE_DESKNET_SYNC=false
