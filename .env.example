# ============================================================
# Construction-LegalOps-DX 環境変数サンプル
# 利用方法: `cp .env.example .env` の上、値を埋めてください。
# 本ファイルはコミット対象、`.env` はコミット対象外（.gitignore 済み）。
# ============================================================

# ------------------------------------------------------------
# 実行環境
# ------------------------------------------------------------
# development | staging | production
APP_ENV=development
# debug | info | warning | error
LOG_LEVEL=info
# UTC 推奨。日本時間で扱う場合は Asia/Tokyo
TZ=Asia/Tokyo

# ------------------------------------------------------------
# サービスポート
# ------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80

# ------------------------------------------------------------
# データベース (PostgreSQL 16)
# ------------------------------------------------------------
# 例: postgresql+asyncpg://user:password@host:5432/dbname
DB_URL=postgresql+asyncpg://legalops:legalops_dev@postgres:5432/legalops
POSTGRES_USER=legalops
POSTGRES_PASSWORD=legalops_dev
POSTGRES_DB=legalops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------
# Redis (キャッシュ・ジョブキュー)
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------
# 認証 / JWT
# ------------------------------------------------------------
# 必ず本番環境では十分なエントロピーを持つランダム値に置き換える
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ------------------------------------------------------------
# Microsoft Entra ID (OIDC / SSO)
# ------------------------------------------------------------
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-entra-app-secret
ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback
# 例: openid profile email offline_access User.Read Sites.Read.All
ENTRA_SCOPES=openid profile email offline_access User.Read

# ------------------------------------------------------------
# Anthropic Claude API (AI 法務アシスト)
# ------------------------------------------------------------
CLAUDE_API_KEY=sk-ant-replace-me
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_MAX_TOKENS=4096
# AI 出力には必ず人間レビューが必要（README の免責参照）
CLAUDE_TIMEOUT_SECONDS=60

# ------------------------------------------------------------
# SharePoint Online (契約書ストレージ連携)
# ------------------------------------------------------------
SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/legal
SHAREPOINT_DRIVE_ID=
SHAREPOINT_LIBRARY_NAME=Contracts

# ------------------------------------------------------------
# desknet's NEO (社内ワークフロー連携)
# ------------------------------------------------------------
DESKNET_API_URL=https://desknet.example.co.jp/api/v1
DESKNET_API_TOKEN=replace-with-desknet-token

# ------------------------------------------------------------
# CORS / フロント連携
# ------------------------------------------------------------
# カンマ区切りで複数指定可
CORS_ORIGINS=http://localhost:3000,http://localhost
# フロントから参照する API ベース URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------
# 監査ログ / 電子帳簿保存法対応
# ------------------------------------------------------------
# 法定保存期間（年）。建設業法・電帳法に従って設定。
AUDIT_RETENTION_YEARS=10
# 監査ログ用バケット / 出力先（実装は Loop 2 以降）
AUDIT_LOG_SINK=stdout

# ------------------------------------------------------------
# 機能フラグ
# ------------------------------------------------------------
FEATURE_AI_REVIEW=true
FEATURE_SHAREPOINT_SYNC=false
FEATURE_DESKNET_SYNC=false
