# LegalOps prod Celery beat (replaces legalops-celery-beat). Schedule/pid live in %t/legalops-beat. 2026-09-04
[Unit]
Description=LegalOps prod Celery beat
After=network.target legalops-redis.service
Wants=legalops-redis.service

[Service]
Type=simple
User=kensan
Group=kensan
WorkingDirectory=/home/kensan/Projects/Mirai-DX-Project/Construction-LegalOps-DX/backend
EnvironmentFile=/etc/legalops/prod-backend.env
Environment=PYTHONPATH=/home/kensan/Projects/Mirai-DX-Project/Construction-LegalOps-DX/backend
RuntimeDirectory=legalops-beat
ExecStart=/home/kensan/Projects/Mirai-DX-Project/Construction-LegalOps-DX/backend/.venv/bin/celery -A app.worker.celery_app beat --loglevel=info --schedule=%t/legalops-beat/celerybeat-schedule --pidfile=%t/legalops-beat/celerybeat.pid
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
