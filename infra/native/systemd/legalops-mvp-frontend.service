# LegalOps mvp Next.js standalone server (replaces construction-legalops-mvp-frontend-1). 2026-09-04
[Unit]
Description=LegalOps mvp frontend (Next.js standalone 127.0.0.1:3013)
After=network.target

[Service]
Type=simple
User=kensan
Group=kensan
WorkingDirectory=/home/kensan/Projects/Mirai-DX-Project/Construction-LegalOps-DX/frontend
EnvironmentFile=/etc/legalops/mvp-frontend.env
ExecStart=/home/kensan/.nvm/versions/node/v20.20.2/bin/node .next/standalone/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
