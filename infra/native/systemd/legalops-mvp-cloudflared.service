# Host cloudflared for legalops-mvp.mirai-dx-platform.com (replaces the in-compose cloudflared container). 2026-09-04
[Unit]
Description=LegalOps mvp Cloudflare Tunnel -> 127.0.0.1:8412
After=network-online.target legalops-nginx.service
Wants=network-online.target

[Service]
Type=simple
User=kensan
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /home/kensan/.cloudflared/legalops-mvp-native-config.yml tunnel run
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
