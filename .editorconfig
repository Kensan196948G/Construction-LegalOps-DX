# EditorConfig: https://editorconfig.org
# 本リポジトリ全体のエディタ共通設定
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ---------- Python (backend) ----------
[*.{py,pyi}]
indent_size = 4
max_line_length = 100

# ---------- Frontend (TS/JS/JSON/CSS/HTML) ----------
[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,scss,html,vue,svelte}]
indent_size = 2

# ---------- YAML / TOML ----------
[*.{yml,yaml,toml}]
indent_size = 2

# ---------- Markdown ----------
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# ---------- Makefile ----------
[Makefile]
indent_style = tab

# ---------- Shell ----------
[*.{sh,bash,zsh}]
indent_size = 2

# ---------- Dockerfile ----------
[{Dockerfile,Dockerfile.*}]
indent_size = 2
